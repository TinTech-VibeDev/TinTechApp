<resources>
    <style name="Theme.FilmBuff.Base" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#A9E4D1</item>
        <item name="colorPrimaryVariant">#4E9E87</item>
        <item name="colorOnPrimary">#101D1A</item>
        <item name="colorSecondary">#F1B689</item>
        <item name="colorSurface">#172127</item>
        <item name="colorOnSurface">#F5F7F8</item>
        <item name="android:colorAccent">#A9E4D1</item>
        <item name="android:statusBarColor">#0A1117</item>
        <item name="android:navigationBarColor">#0A1117</item>
        <item name="android:windowBackground">#0A1117</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.FilmBuff" parent="Theme.FilmBuff.Base" />
    <style name="FilmBuffControl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/control_size</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/control_focus</item>
        <item name="android:textColor">#F5F7F8</item>
        <item name="android:textSize">@dimen/control_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="FilmBuffIcon" parent="FilmBuffControl">
        <item name="android:layout_width">@dimen/control_size</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">#F5F7F8</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
