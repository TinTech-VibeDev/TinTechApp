<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FilmBuff" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF7A18</item>
        <item name="colorPrimaryVariant">#FF5A00</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#36A9FF</item>
        <item name="android:statusBarColor">#050507</item>
        <item name="android:navigationBarColor">#050507</item>
        <item name="android:windowBackground">#050507</item>
        <item name="android:windowSplashScreenBackground">#050507</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_full</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#050507</item>
    </style>

    <style name="FilmBuff.PlayerIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/player_control_button_bg</item>
        <item name="android:tint">#FFFFFF</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>
