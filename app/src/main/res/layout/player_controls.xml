<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/exo_top_controls" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr">
    <!-- Fade the custom controller as one group. The stock bottom-bar minimum-height
         calculation assumes a single row and would hide our two-row controls on phones. -->
    <View android:id="@id/exo_controls_background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#22000000" />
    <LinearLayout android:id="@+id/playerHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
        android:paddingStart="@dimen/player_margin" android:paddingEnd="@dimen/player_margin" android:paddingTop="14dp" android:paddingBottom="32dp" android:gravity="center_vertical" android:background="@drawable/player_top_scrim">
        <ImageButton android:id="@+id/btnClose" style="@style/FilmBuffIcon" android:src="@drawable/ic_close" android:contentDescription="بستن پلیر" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/playerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="@dimen/player_title" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/playerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9F6E1" android:textSize="12sp" android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnPip" style="@style/FilmBuffIcon" android:src="@drawable/ic_pip" android:contentDescription="تصویر در تصویر" />
    </LinearLayout>
    <LinearLayout android:id="@+id/playerCenter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center">
        <ImageButton android:id="@id/exo_rew" style="@style/FilmBuffIcon" android:src="@drawable/ic_rewind" android:contentDescription="۱۰ ثانیه عقب" />
        <ImageButton android:id="@id/exo_play_pause" style="@style/FilmBuffIcon" android:layout_width="70dp" android:layout_height="70dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:contentDescription="پخش یا مکث" />
        <ImageButton android:id="@id/exo_ffwd" style="@style/FilmBuffIcon" android:src="@drawable/ic_forward" android:contentDescription="۱۰ ثانیه جلو" />
    </LinearLayout>
    <LinearLayout android:id="@+id/playerBottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingStart="@dimen/player_margin" android:paddingEnd="@dimen/player_margin" android:paddingTop="30dp" android:paddingBottom="12dp" android:background="@drawable/player_bottom_scrim">
        <LinearLayout android:id="@+id/playerTime" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
            <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" />
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BBC9D1" android:textSize="13sp" />
        </LinearLayout>
        <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="match_parent" android:layout_height="30dp"
            android:focusable="true" android:contentDescription="زمان پخش" app:played_color="#A9E4D1" app:buffered_color="#7C9B94" app:unplayed_color="#3D4A50" app:scrubber_color="#E3FFF5" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="true">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <Button android:id="@+id/btnSubtitles" style="@style/FilmBuffControl" android:text="زیرنویس" />
                <Button android:id="@+id/btnQuality" style="@style/FilmBuffControl" android:text="کیفیت" />
                <Button android:id="@+id/btnAudio" style="@style/FilmBuffControl" android:text="صدا" />
                <Button android:id="@+id/btnSpeed" style="@style/FilmBuffControl" android:text="سرعت" />
                <Button android:id="@+id/btnAspect" style="@style/FilmBuffControl" android:text="اندازه" />
                <Button android:id="@+id/btnNetwork" style="@style/FilmBuffControl" android:text="اتصال" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
