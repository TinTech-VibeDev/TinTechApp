<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true"
        app:surface_type="surface_view"
        app:use_controller="true" />

    <!-- Only visible together with Media3's controller. Nothing remains on the movie frame. -->
    <LinearLayout
        android:id="@+id/quickControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:background="@drawable/player_top_scrim">

        <ImageButton
            android:id="@+id/btnQuality"
            style="@style/FilmBuffPlayerIconButton"
            android:contentDescription="کیفیت تصویر"
            android:src="@drawable/ic_quality" />

        <ImageButton
            android:id="@+id/btnAudio"
            style="@style/FilmBuffPlayerIconButton"
            android:contentDescription="صدای پخش"
            android:src="@drawable/ic_audio" />

        <ImageButton
            android:id="@+id/btnAspect"
            style="@style/FilmBuffPlayerIconButton"
            android:contentDescription="اندازه تصویر"
            android:src="@drawable/ic_aspect" />

        <ImageButton
            android:id="@+id/btnPip"
            style="@style/FilmBuffPlayerIconButton"
            android:contentDescription="تصویر در تصویر"
            android:src="@drawable/ic_pip" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnClose"
            style="@style/FilmBuffPlayerIconButton"
            android:contentDescription="بستن پلیر"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_hint_bg"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
