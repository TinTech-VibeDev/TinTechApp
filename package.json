{
  "name": "filmbuff-desktop",
  "productName": "FilmBuff",
  "version": "1.0.2",
  "description": "FilmBuff Desktop — تماشای فیلم و سریال در وب‌ویو دسکتاپ",
  "main": "main.js",
  "author": {
    "name": "FilmBuff",
    "email": "support@filmbuff.ir"
  },
  "license": "MIT",
  "homepage": "https://f.filmbuff.ir",
  "repository": {
    "type": "git",
    "url": "https://github.com/TinTech-VibeDev/TinTechApp.git"
  },
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps || echo skip-install-app-deps",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "ir.tintech.filmbuff.desktop",
    "productName": "FilmBuff",
    "copyright": "Copyright © FilmBuff",
    "electronVersion": "33.2.1",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FilmBuff-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "FilmBuff-Portable-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FilmBuff",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1065"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
