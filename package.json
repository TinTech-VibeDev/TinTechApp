{
  "name": "filmbuff-desktop",
  "productName": "FilmBuff",
  "version": "1.0.0",
  "description": "FilmBuff Desktop — تماشای فیلم و سریال در وب‌ویو دسکتاپ",
  "main": "main.js",
  "author": "FilmBuff",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "ir.tintech.filmbuff.desktop",
    "productName": "FilmBuff",
    "copyright": "Copyright © FilmBuff",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "FilmBuff-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FilmBuff-Portable-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FilmBuff",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "1065"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
