{
  "name": "filmbuff-desktop",
  "productName": "FilmBuff",
  "version": "1.1.0",
  "description": "FilmBuff Desktop",
  "main": "main.js",
  "author": "FilmBuff",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "ir.tintech.filmbuff.desktop",
    "productName": "FilmBuff",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "player-preload.js",
      "player.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "FilmBuff-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FilmBuff",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1065"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "24.13.3"
  }
}
