{
  "name": "filmbuff-desktop",
  "productName": "FilmBuff",
  "version": "1.0.5",
  "description": "FilmBuff Desktop",
  "main": "main.js",
  "author": "FilmBuff",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "ir.tintech.filmbuff.desktop",
    "productName": "FilmBuff",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "player-preload.js",
      "player.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "FilmBuff-${version}-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "24.13.3"
  },
  "files": [
    "main.js",
    "preload.js",
    "assets/**/*"
  ]
}
